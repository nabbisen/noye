name = "noye-gateway"
main = "build/worker/shim.mjs"
compatibility_date = "2024-04-13"
# Public entry point. `workers_dev = false` here means Cloudflare's
# *.workers.dev subdomain is disabled — you must configure a custom route
# (or a zone) for the Gateway to be reachable at all. For local development,
# set `workers_dev = true` in your own copy, or use `wrangler dev`, which
# does not require it.
workers_dev = false

[build]
command = "cargo install -q worker-build && worker-build --release"

# KV (session store + OIDC state + JWKS cache)
[[kv_namespaces]]
binding = "CACHE_KV"
id = "YOUR_KV_ID_HERE"

# Service Binding: internal call to the Core worker
[[services]]
binding = "CORE"
service = "noye-core"
# In production, consider specifying environment = "production"

# Environment variables
[vars]
# ── Deployment environment ──
# Required signal that switches the gateway between development-permissive
# and production-strict behavior. Read by `crates/gateway/src/env_check.rs`.
#
# - "development": cookies drop the `Secure` attribute, so plain-HTTP
#   localhost works.
# - anything else (or unset): cookies are Secure-only.
#
# Independent of this setting: a known dev-fallback value for
# OIDC_CLIENT_SECRET or GATEWAY_SHARED_TOKEN is refused unconditionally,
# in every environment, not only in production. Development is expected to
# supply its own non-denylisted values via `.dev.vars` (see below), not to
# rely on the fallback bypass — there is no bypass.
#
# This template ships "production" — the restrictive default. For local
# development, set NOYE_ENV = "development" in your own copy (or in
# .dev.vars, which wrangler dev merges in and which is git-ignored) rather
# than committing a permissive value here.
NOYE_ENV = "production"

# ── OIDC authentication ──
# Default values point at the included `noye-dev-idp` stub for local development.
# For production deploys, replace with your real IdP (see docs/src/oidc-providers.md).
OIDC_ISSUER_URL = "http://localhost:5556"
OIDC_CLIENT_ID = "noye-local-client"
OIDC_REDIRECT_URI = "http://localhost:8787/auth/callback"
OIDC_SCOPES = "openid email profile"
SESSION_COOKIE_NAME = "noye_session"
SESSION_DURATION_MIN = "480"

# ── Turnstile (limited to public forms) ──
# Site key may be left blank to disable Turnstile entirely. When set, the
# verify_token helper in auth::turnstile gates submission of any public form
# that opts in.
TURNSTILE_SITE_KEY = ""

# ── Test-send rate limit ──
# Per-channel rate limits for the manual "send test notification" action.
# Counted in KV with fixed-window buckets. Setting either to 0 or leaving
# them unset falls back to the safe defaults (5/min, 30/hour).
TEST_SEND_LIMIT_PER_MIN = "5"
TEST_SEND_LIMIT_PER_HOUR = "30"

# ── Login rate limit ──
# Per-IP rate limits applied at /auth/login, BEFORE any KV pending_login
# write. Defends against unauthenticated traffic filling KV (a DoS / quota-
# exhaustion vector). Counted in KV with fixed-window buckets, scoped by
# CF-Connecting-IP. Setting either to 0 or leaving them unset falls back to
# the safe defaults (10/min, 50/hour). Loosen these with caution — every
# legitimate user logs in only a handful of times per day.
LOGIN_RATE_LIMIT_PER_MIN = "10"
LOGIN_RATE_LIMIT_PER_HOUR = "50"

# ── OIDC_CLIENT_SECRET / GATEWAY_SHARED_TOKEN ──
# Neither is set here. This is deliberate: a value committed to this
# template is a value published in a public repository, and
# `check_no_leaked_dev_fallbacks` now refuses to serve any request while a
# known dev-fallback value is observed — unconditionally, regardless of
# NOYE_ENV.
#
# Deployment: register both with `wrangler secret put <name>`.
# GATEWAY_SHARED_TOKEN must match the value set on Core.
#
# Local development: put both in `.dev.vars` (git-ignored, merged in by
# `wrangler dev`) instead of in this file:
#   OIDC_CLIENT_SECRET=anything-not-on-the-denylist
#   GATEWAY_SHARED_TOKEN=<any value that matches Core's .dev.vars>
# The dev-idp stub does not check OIDC_CLIENT_SECRET's value, so any
# string works — but not the literal former default: the denylist check
# is unconditional now, so a `.dev.vars` carrying the old default value
# would be refused locally too, exactly like in production.

# NOTE: the following must be registered as Secrets (wrangler secret put <name>):
#   OIDC_CLIENT_SECRET       - OIDC client secret
#   GATEWAY_SHARED_TOKEN     - Shared secret between Gateway and Core (set the same value on Core)
#   TURNSTILE_SECRET_KEY     - Turnstile secret key (only required if TURNSTILE_SITE_KEY is set)
